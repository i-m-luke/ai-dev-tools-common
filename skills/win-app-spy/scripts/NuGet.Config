<?xml version="1.0" encoding="utf-8"?>
<!-- dotnet-script restores with the NuGet.Config nearest to the script; this one keeps feeds and
     package source mappings of the folders above the skill out of the restore. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
