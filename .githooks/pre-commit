#!/bin/sh
# Blocks the commit when a script test fails (see docs/verification/script-tests.md).
# Git exports repo-local variables (e.g. GIT_DIR) to hooks; clear them so tests that create their own repos are unaffected.
unset $(git rev-parse --local-env-vars)
out=$(pwsh -NoProfile -File tools/script-tests.ps1 2>&1) && exit 0
# VS Code's dialog shows only the first line; the failures the script lists last follow under "Show Command Output".
failures=$(printf '%s\n' "$out" | sed -n '/^Script tests failed:$/,$p' | sed '1d')
{
    echo 'Commit blocked - script tests failed (for details see Command Output):'
    printf '%s\n' "${failures:-- see the full output below}"
    echo 'Fix them, or skip the check once with "Commit (No Verify)" in VS Code or git commit --no-verify.'
    echo
    printf '%s\n' "$out"
} >&2
exit 1
